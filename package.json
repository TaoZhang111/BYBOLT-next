{
  "name": "vk",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.18.3",
  "scripts": {
    "dev": "next dev",
    "styles:generate": "node scripts/sync-accepted-styles.mjs",
    "build": "next build",
    "preview": "pnpm build && wrangler pages dev out",
    "deploy:preview": "pnpm build && wrangler pages deploy out --project-name bybolt-next-preview --branch preview",
    "deploy:production": "pnpm build && wrangler pages deploy out --project-name bybolt-next-preview --branch main",
    "deploy:admin-api": "wrangler deploy --config workers/admin-api/wrangler.jsonc",
    "qa:admin": "node scripts/qa-admin.mjs",
    "start": "next start",
    "lint": "eslint"
  },
  "dependencies": {
    "@gsap/react": "^2.1.2",
    "gsap": "^3.15.0",
    "lucide-react": "^1.25.0",
    "next": "16.2.11",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@opennextjs/cloudflare": "^1.20.2",
    "@playwright/test": "^1.61.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.11",
    "tailwindcss": "^4",
    "typescript": "^5",
    "wrangler": "^4.113.0"
  },
  "overrides": {
    "postcss": "^8.5.10",
    "sharp": "^0.35.0"
  }
}
