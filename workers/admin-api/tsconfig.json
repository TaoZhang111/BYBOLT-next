{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "baseUrl": "../..",
    "paths": { "@/*": ["src/*"] },
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "types": []
  },
  "include": [".wrangler/types.d.ts", "src/**/*.ts", "../../src/lib/products/schema.ts", "../../src/lib/materials/schema.ts", "../../src/types/**/*.ts"]
}
